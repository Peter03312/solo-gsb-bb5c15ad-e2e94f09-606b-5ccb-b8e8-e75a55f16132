# Optional runtime configuration (prefix CAL_). Copy to .env if needed.
CAL_HOST=0.0.0.0
CAL_PORT=8080
CAL_LOG_LEVEL=info

# Storage backend:
#   memory - process-local state, lost on restart/reset (original behavior);
#   sqlite - durable state in one WAL-mode SQLite file, survives restarts and
#            is shared by all service processes pointed at the same file.
CAL_STORAGE_BACKEND=sqlite
# Database file used when CAL_STORAGE_BACKEND=sqlite (parent dirs auto-created;
# mount a volume/host path there for persistence).
CAL_SQLITE_PATH=/data/calibration.db
# Milliseconds to wait for another process' SQLite write lock before returning
# an explicit 503 storage error.
CAL_SQLITE_BUSY_TIMEOUT_MS=5000
