# Optional runtime configuration (prefix CAL_). Copy to .env if needed.
CAL_HOST=0.0.0.0
CAL_PORT=8080
CAL_LOG_LEVEL=info

# Storage backend:
#   sqlite - durable file, survives restarts and shared by all worker
#            processes using the same path (default; WAL journal mode);
#   memory - ephemeral process-local storage (lost on restart/reset).
CAL_STORAGE=sqlite
# SQLite database file when CAL_STORAGE=sqlite (parent dir is auto-created).
CAL_SQLITE_PATH=data/calibration.db
# Milliseconds to wait on another process holding the SQLite write lock.
CAL_SQLITE_BUSY_TIMEOUT_MS=10000
